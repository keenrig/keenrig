{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keenrig.com/schemas/manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "image", "httpPort"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "image": { "type": "string", "pattern": "@sha256:" },
    "httpPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "addons": { "$ref": "https://keenrig.com/schemas/desired.schema.json#/$defs/Addons" },
    "healthcheck": {
      "type": "object",
      "properties": {
        "path": { "type": "string", "default": "/" },
        "interval_s": { "type": "integer", "minimum": 1 },
        "timeout_s": { "type": "integer", "minimum": 1 }
      }
    },
    "needs_tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "scalable": { "type": "boolean", "default": false }
  }
}
